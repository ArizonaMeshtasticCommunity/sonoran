# azmsh.net dashboard configuration.
# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# Database. One URL per process role.
DATABASE_URL=postgresql+asyncpg://azmsh_ingest:change_me@timescaledb:5432/azmsh
DATABASE_URL_API=postgresql+asyncpg://azmsh_api:change_me@timescaledb:5432/azmsh
DATABASE_URL_JOBS=postgresql+asyncpg://azmsh_jobs:change_me@timescaledb:5432/azmsh

# TimescaleDB superuser (used by the db container only).
POSTGRES_PASSWORD=change_me

# MQTT broker (azmsh.net broker).
MQTT_HOST=mqtt.azmsh.net
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
WEB_BASE_PATH=
# Optional absolute API origin for a separate static-file preview host.
WEB_API_BASE_URL=
MQTT_TOPICS=msh/US/AZ/#

# Channel keys. Full base64 AES keys, comma-separated.
CHANNEL_KEYS=1PG7OiApB1nwvP+rz05pAQ==

# The channels this mesh claims as its own, comma-separated. A LoRa
# modem preset is always core, so list only the local names here.
# Everything else shows as extra in the channel pickers.
CORE_CHANNELS=azmsh

# mesh-graph public base URL.
MESH_GRAPH_BASE_URL=http://localhost:8080

# Privacy switch. Set true to store text message bodies.
STORE_TEXT_MESSAGES=false

# Web server.
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Every time on the dashboard is shown in this zone. Arizona has no
# daylight saving, so it stays on MST all year.
DISPLAY_TIMEZONE=America/Phoenix

# Map basemap. The tile host is added to the image sources of the CSP.
# Set MAP_TILE_URL empty to hide the basemap and show the nodes only.
#
# openstreetmap.org tiles are fine at mesh scale. Keep the attribution,
# and note the site must send a Referer, or OSM answers with a "blocked"
# placeholder tile; the Referrer-Policy header is set for that. Use one
# host with no {s} placeholder so the CSP origin matches. A provider such
# as CARTO (https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png, needs
# no Referer) or your own tile server leans on OSM's servers less.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=(c) OpenStreetMap contributors
MAP_DEFAULT_LAT=34.0
MAP_DEFAULT_LON=-111.5
MAP_DEFAULT_ZOOM=7

# Coverage planner terrain.
# Pages are made from SRTM tiles once and kept on disk. Fill the cache
# with:  uv run python tools/prefetch_terrain.py
# Then set TERRAIN_ALLOW_DOWNLOAD=false. The API then serves the cache
# and makes no outbound request.
TERRAIN_CACHE_DIR=/var/lib/sonoran/terrain
TERRAIN_SOURCE_URL=https://elevation-tiles-prod.s3.amazonaws.com
TERRAIN_ALLOW_DOWNLOAD=true
# The region the planner covers. Arizona, plus one degree on each side.
# A tile outside these bounds is never fetched and never served.
TERRAIN_LAT_MIN=30
TERRAIN_LAT_MAX=37
TERRAIN_LON_MIN=-116
TERRAIN_LON_MAX=-109

# Land cover. The pages say what stands on the ground, so a prediction
# can charge the clutter loss that ITM leaves out. Make them once with
# tools/prefetch_landcover.py. With no pages the prediction has no
# clutter, which is what the planner has always done.
LANDCOVER_CACHE_DIR=/var/lib/sonoran/landcover

# Coverage map. The job predicts from every node the mesh reports and
# writes tiles the browser caches.
COVERAGE_CACHE_DIR=/var/lib/sonoran/coverage
COVERAGE_ENABLED=true
# How often the job runs. A run costs about a second for each node.
COVERAGE_INTERVAL_HOURS=6
# A node not heard from in this long is left out, so a node that is
# gone does not hold coverage open on the map.
COVERAGE_ACTIVE_HOURS=168
# How far each node is predicted to reach.
COVERAGE_RADIUS_KM=60
# The largest number of nodes one run predicts from. The strongest
# sites are taken first.
COVERAGE_MAX_NODES=600
# Worker processes. Zero means as many as the machine has, less one.
COVERAGE_WORKERS=0
# The receiver the map assumes: a handheld with a stock antenna.
COVERAGE_RX_HEIGHT_M=1.5
COVERAGE_RX_GAIN_DBI=2.15
# The zoom levels of tile the job writes. Level 11 is finer than the
# 90 m terrain, so there is nothing to gain past it.
COVERAGE_MIN_ZOOM=6
COVERAGE_MAX_ZOOM=11

# The public coverage embed. It is off until you turn it on, which is
# the same default STORE_TEXT_MESSAGES takes: the private value is the
# safe one.
#
# The embed is its own page at /embed/coverage. It shows the coverage
# and the infrastructure sites, with the positions snapped to a grid.
# It never shows a client node.
EMBED_ENABLED=false
# The sites that may put the embed in a frame, comma separated. Give
# full origins. Anything else is dropped, and an empty list means
# nothing may frame it.
EMBED_FRAME_ANCESTORS=
# How far to snap a public marker, in degrees. About 0.01 is a
# kilometre, which names a hill and not a building.
EMBED_POSITION_STEP=0.01

# Calibration. The job asks the mesh how far the prediction is out,
# node by node, from the neighbour reports the nodes publish.
CALIBRATION_ENABLED=true
CALIBRATION_INTERVAL_HOURS=24
# How far back to read neighbour reports. They are kept for
# RETENTION_DAYS_METRIC days, so a longer window reads nothing.
CALIBRATION_WINDOW_HOURS=336

# Radio overrides. The file names the antenna, the mast height, and the
# power of a node, which the mesh itself never reports. It is kept in
# the repository, so every change to it has an author and a review. A
# file that is not there gives no overrides.
RADIO_OVERRIDES_PATH=config/nodes.yaml

# Logging.
LOG_LEVEL=INFO
