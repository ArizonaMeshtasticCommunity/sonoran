# azmsh.net dashboard configuration.
# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# Database.
#
# EVERY CHANGE_ME BELOW IS A PLACEHOLDER AND MUST BE REPLACED. The
# migration that creates the three roles refuses to run while one of
# the role passwords is missing, empty or still CHANGE_ME, so a copy of
# this file that was not edited fails at the first `docker compose up`
# with the variable named. It does not come up and quietly serve.
#
# Generate four different values, for example:
#   for v in POSTGRES AZMSH_INGEST AZMSH_API AZMSH_JOBS; do \
#     echo "$v=$(openssl rand -base64 24 | tr -d '/+=')"; done
#
# One role per process, each with the smallest rights that do its job:
# ingest INSERTs, the api only SELECTs, jobs reads and aggregates. The
# split is worth nothing if one process holds another's password, so
# docker-compose.yml gives each service its own DSN and blanks the
# rest. See `x-no-credentials` there.

# The password of each role. Revision 0001 creates the roles with
# these. Each must match the password in the matching DATABASE_URL
# below: these create the login, those use it. Set them in pairs:
#
#   AZMSH_INGEST_PASSWORD  <->  the password in DATABASE_URL
#   AZMSH_API_PASSWORD     <->  the password in DATABASE_URL_API
#   AZMSH_JOBS_PASSWORD    <->  the password in DATABASE_URL_JOBS
#
# If a pair disagrees the migration still succeeds and the service then
# cannot log in: "password authentication failed for user azmsh_api".
#
# Changing one later does not change an existing role. Revision 0001
# creates a role only when it is absent. Use ALTER ROLE as the
# superuser, and edit the matching DATABASE_URL in the same change.
# See docs/DATABASE.md 2.1.
AZMSH_INGEST_PASSWORD=CHANGE_ME
AZMSH_API_PASSWORD=CHANGE_ME
AZMSH_JOBS_PASSWORD=CHANGE_ME

# One URL per process role. The password in each must be the value of
# the matching AZMSH_*_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://azmsh_ingest:CHANGE_ME@timescaledb:5432/azmsh
DATABASE_URL_API=postgresql+asyncpg://azmsh_api:CHANGE_ME@timescaledb:5432/azmsh
DATABASE_URL_JOBS=postgresql+asyncpg://azmsh_jobs:CHANGE_ME@timescaledb:5432/azmsh

# TimescaleDB superuser. The database container uses it, and the
# migrate service builds DATABASE_URL_MIGRATE from it. No other service
# receives it.
POSTGRES_PASSWORD=CHANGE_ME

# MQTT broker. The default is the azmsh.net broker, which needs a login
# from that community. For a different mesh, set your own broker, its
# login, and the topics your gateways publish to (for example msh/US/#).
# The mesh-graph service reads the same host, port and login, but takes
# its topic from mesh-graph.config.toml: change it there too.
MQTT_HOST=mqtt.azmsh.net
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
# Seconds between MQTT keepalive pings. The RF and contributor services
# use the same value.
MQTT_KEEPALIVE=60
WEB_BASE_PATH=
# Optional absolute API origin for a separate static-file preview host.
WEB_API_BASE_URL=
MQTT_TOPICS=msh/US/AZ/#

# Channel keys. Full base64 AES keys (16 or 32 bytes), comma-separated,
# tried in order. Only the ingest service receives them.
#
# The value below is the public Meshtastic default key, which every
# default channel uses. It is published, so it is not a secret. Add the
# keys of your own channels after it, for example:
#   CHANNEL_KEYS=1PG7OiApB1nwvP+rz05pAQ==,<your channel key>
#
# The Meshtastic apps show the default key in a short form, AQ==. Sonoran
# does not read the short form: ingest stops at start-up with
# KeyDecodeError. Give the full key. Do not leave this empty either:
# docker-compose.yml then passes an empty value, which gives no key at
# all, and ingest stores every packet with an unknown port.
CHANNEL_KEYS=1PG7OiApB1nwvP+rz05pAQ==

# The channels this mesh claims as its own, comma-separated. A LoRa
# modem preset is always core, so list only the local names here.
# Everything else shows as extra in the channel pickers.
CORE_CHANNELS=azmsh
# The preset every page opens on when it has a choice. Falls back to
# whatever the data offers when this preset is not present.
DEFAULT_PRESET=MediumFast
# Ingest tags each packet with the modem preset that carried it. A
# gateway that uploads on two different preset-named topics within this
# many minutes is ambiguous, and its other uploads get no preset.
GATEWAY_PRESET_CONFLICT_MINUTES=60
# How far ahead of our own receipt time a node's timestamp may be, in
# seconds, before ingest refuses it. A stamp behind us is ordinary store
# and forward; a stamp ahead of us names a moment that had not happened.
# See src/sonoran/ingest/handlers/clocks.py.
MESH_FUTURE_SLACK_SECONDS=300

# mesh-graph public base URL.
MESH_GRAPH_BASE_URL=http://localhost:8080
# Where the API reaches mesh-graph itself, on the compose network. It
# fetches trace drawings from here and recolours them for the dark site.
MESH_GRAPH_INTERNAL_URL=http://mesh-graph:8080
# How long the API waits for one trace drawing from mesh-graph, in seconds.
MESH_GRAPH_TIMEOUT_SECONDS=10

# The RF map (docs/design/rf-map.md). `sonoran-rf-ingest` runs only with
#   docker compose --profile rf up -d rf-ingest
# It reads what rf-agent stations publish on rf/v1/#. An empty host
# means the Meshtastic broker above. Give it a login that can read
# rf/v1/# and nothing else.
RF_MQTT_HOST=
RF_MQTT_PORT=1883
RF_MQTT_USERNAME=
RF_MQTT_PASSWORD=
RF_MQTT_USE_TLS=false
RF_TOPICS=rf/v1/#

# Contributors (#178, docs/design/contributors.md). `sonoran-contrib` runs
# only with
#   docker compose --profile contrib up -d contrib
# Its login is the only one that may publish jobs: give it the rf-registrar's
# dispatcher rules (DISPATCHER_USERNAME there). An empty host means the RF
# broker above.
CONTRIB_MQTT_HOST=
CONTRIB_MQTT_PORT=1883
CONTRIB_MQTT_USERNAME=
CONTRIB_MQTT_PASSWORD=
CONTRIB_MQTT_USE_TLS=false
CONTRIB_TICK_SECONDS=60
# One track point per aircraft per this many seconds, across stations.
RF_BUCKET_SECONDS=20
# A point stamped more than this many seconds ahead of our clock, or more
# than this many behind it, is stored with the time we received it.
RF_FUTURE_SLACK_SECONDS=60
RF_PAST_SLACK_SECONDS=600
# Aircraft never stored or shown: the FAA LADD and PIA lists, as lower
# case ICAO hex, comma separated. Loaded by an operator, never fetched.
RF_HIDDEN_IDS=
# The rtl_433 model names whose readings are stored, comma separated,
# for example Acurite-Tower,Fineoffset-WH51. rtl_433 also decodes tyre
# sensors, doorbells and car keys, so empty means NONE are stored. The
# match is the whole name, ignoring case (design 8).
RF_ISM_ALLOW=
# Channels this mesh set itself, marked on the waterfall beside each
# preset's default: Preset:slot, comma separated, slots counted from 1
# as the app counts them. Such as MediumFast:18 (906.375 MHz).
RF_CUSTOM_CHANNELS=
# Limits per station, so one login cannot flood the ingest (#324). Over
# a limit is dropped and logged once an hour per station. Messages and
# points are token buckets: a rate a minute, and a burst for an agent
# sending what it queued while the broker was away.
RF_QUOTA_MESSAGES_PER_MINUTE=240
RF_QUOTA_MESSAGES_BURST=2400
RF_QUOTA_POINTS_PER_MINUTE=3000
RF_QUOTA_POINTS_BURST=30000
# Spectrum: at most this many ranges, and bins in all, per station and
# minute. Ranges never stored, as start:end in Hz, comma separated.
RF_SPECTRUM_MAX_RANGES=4
RF_SPECTRUM_MAX_BINS=8192
RF_SPECTRUM_REFUSED_RANGES=
# Members' mods: points a minute (rate and burst) and ids a day.
RF_CUSTOM_POINTS_PER_MINUTE=600
RF_CUSTOM_POINTS_BURST=6000
RF_CUSTOM_MAX_IDS=1000
# How often the ingest reads the operators' trust levels again.
RF_TRUST_REFRESH_SECONDS=60

# Privacy switch. Set true to store text message bodies.
STORE_TEXT_MESSAGES=false

# Retention in days, per data family. Revision 0005 reads these when it
# is first applied and sets the TimescaleDB retention policy of each
# table. A later change does NOT change the policy of a database that
# already has that revision: change the policy by hand as the superuser
# (remove_retention_policy, then add_retention_policy). The application
# also reads RETENTION_DAYS_PACKET and RETENTION_DAYS_METRIC to bound its
# windows, so keep them equal to the policies.
RETENTION_DAYS_PACKET=30
RETENTION_DAYS_POSITION=30
RETENTION_DAYS_METRIC=90
RETENTION_DAYS_TRACEROUTE=90
RETENTION_DAYS_TEXT=30

# Web server.
WEB_HOST=0.0.0.0
WEB_PORT=8000
# API worker processes (#371). Each has one event loop and its own short
# caches. Keep 1 on a small box; a bigger box can run several, because the
# long views are read from the jobs' tables.
WEB_WORKERS=1

# How long the whole-table statistics are held before counting again.
#
# /api/stats, /api/stats/hardware and /api/stats/portnums are the only
# answers in the API with no time window: they count every row ever
# kept, so their cost grows with retention and not with what the reader
# asked for. The dashboard asks for all three on every load.
#
# One reader is answered from the database and everybody else inside
# the window shares that answer. Zero turns the hold off and counts on
# every request, which a small database or a spare core can afford.
STATS_CACHE_SECONDS=30
# The longest hold (#371). The hold grows with the window: 1/720 of it,
# so a day is held 2 minutes and 3 days or more this long. A range that
# ended in the past cannot change and is held this long too.
STATS_CACHE_MAX_SECONDS=300

# How long one node's links and routes are held (#304). They cover up to
# thirty days, so five minutes of age changes nothing a reader sees.
ROUTES_CACHE_SECONDS=300

# Each API caller's request budget (docs/API.md 1.1). A token bucket:
# BURST requests at once, then PER_SECOND sustained. Far above any page.
# Off by default: turn it on only once FORWARDED_ALLOW_IPS (below) gives
# the API real client addresses, or every reader shares one budget.
# A deployment that other people can reach needs both. See SECURITY.md 3.
# This file keeps it off because a copy of it with true and no
# FORWARDED_ALLOW_IPS gives every reader one shared budget, and a busy
# page then gets 429.
API_RATE_LIMIT_ENABLED=false
API_RATE_BURST=300
API_RATE_PER_SECOND=3
API_TILE_RATE_BURST=3000
API_TILE_RATE_PER_SECOND=30
# Key the budget on the signed-in user in this header, not the address.
# Only a header the login proxy REPLACES on every request, or a caller
# can pick a fresh budget per request. Caddy + Authelia: Remote-User.
# API_RATE_USER_HEADER=Remote-User

# The proxy addresses whose X-Forwarded-For uvicorn believes. Without it
# every caller has the proxy's address, and shares one request budget.
# Behind rootless Docker this is the API network's gateway.
# FORWARDED_ALLOW_IPS=172.18.0.1

# Every time on the dashboard is shown in this zone. Arizona has no
# daylight saving, so it stays on MST all year.
DISPLAY_TIMEZONE=America/Phoenix

# Map basemap. The tile host is added to the image sources of the CSP.
# Set MAP_TILE_URL empty to hide the basemap and show the nodes only.
#
# openstreetmap.org tiles are fine at mesh scale. Keep the attribution,
# and note the site must send a Referer, or OSM answers with a "blocked"
# placeholder tile; the Referrer-Policy header is set for that. Use one
# host with no {s} placeholder so the CSP origin matches. A provider such
# as CARTO (https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png, needs
# no Referer) or your own tile server leans on OSM's servers less.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=(c) OpenStreetMap contributors
MAP_DEFAULT_LAT=34.0
MAP_DEFAULT_LON=-111.5
MAP_DEFAULT_ZOOM=7
# The area the live map opens on, in degrees (#195). The map fits this box
# to the screen. Nodes outside it are still drawn, but they do not move
# the first view. Address search on the planner also drops every answer
# outside it. The default is Arizona: set your own for a different mesh.
MAP_HOME_SOUTH=31.2
MAP_HOME_WEST=-115.0
MAP_HOME_NORTH=37.1
MAP_HOME_EAST=-108.9

# Address search on the coverage planner. This is the one setting that
# sends what a reader typed to a third party: the API forwards it to this
# geocoder (src/sonoran/api/routes/geocode.py). Set GEOCODE_URL empty to
# turn the feature off. The endpoint then answers 404 and the page draws
# no search box. Answers outside MAP_HOME_* are dropped.
GEOCODE_URL=https://nominatim.openstreetmap.org/search
# How long one lookup may take, in seconds.
GEOCODE_TIMEOUT_SECONDS=8
# Who this server says it is. Nominatim's usage policy requires an agent
# that names the application. Put your own deployment's name here.
GEOCODE_USER_AGENT=sonoran-dashboard (Arizona Meshtastic Community)

# Coverage planner terrain.
# Pages are made from SRTM tiles once and kept on disk. Fill the cache
# with:  uv run python tools/prefetch_terrain.py
# Then set TERRAIN_ALLOW_DOWNLOAD=false. The API then serves the cache
# and makes no outbound request.
TERRAIN_CACHE_DIR=/var/lib/sonoran/terrain
TERRAIN_SOURCE_URL=https://elevation-tiles-prod.s3.amazonaws.com
#
# RECOMMENDED POSTURE: run tools/prefetch_terrain.py once and set this
# to false. /api/terrain/page/{tile} is served to anybody, and while
# this is true an uncached in-region tile makes a stranger's request
# start an outbound fetch and a CPU-bound decode on this box. With it
# false the API cannot make an outbound request at all, which is the
# only complete answer. The two settings below bound the exposure for
# a deployment that has not prefetched yet; they do not remove it.
TERRAIN_ALLOW_DOWNLOAD=true
# How long one outbound tile fetch may take. This was 120 seconds: a
# public request could hold a connection and a worker thread for two
# minutes, and a slow tile source was then a slow API for everybody.
TERRAIN_TIMEOUT_SECONDS=30
# How many different tiles may be fetched from the source at once.
#
# The cache on disk is bounded by the region. The work in flight was
# not: the per-tile lock stops the same tile being fetched twice and
# says nothing about different ones, and the region holds 56 tiles. Two
# at a time fills a cold cache at a sensible rate and leaves the thread
# pool to the rest of the API.
TERRAIN_DOWNLOAD_CONCURRENCY=2
# The region the planner covers. Arizona, plus one degree on each side.
# A tile outside these bounds is never fetched and never served.
TERRAIN_LAT_MIN=30
TERRAIN_LAT_MAX=37
TERRAIN_LON_MIN=-116
TERRAIN_LON_MAX=-109

# Land cover. The pages say what stands on the ground, so a prediction
# can charge the clutter loss that ITM leaves out. Make them once with
# tools/prefetch_landcover.py. With no pages the prediction has no
# clutter, which is what the planner has always done.
LANDCOVER_CACHE_DIR=/var/lib/sonoran/landcover

# Coverage map. The job predicts from the selected fixed sites and
# writes tiles the browser caches.
COVERAGE_CACHE_DIR=/var/lib/sonoran/coverage
COVERAGE_ENABLED=true
# How often the job runs. A run costs about a second for each node.
COVERAGE_INTERVAL_HOURS=6
# A node not heard from in this long is left out, so a node that is
# gone does not hold coverage open on the map.
COVERAGE_ACTIVE_HOURS=168
# How far each node is predicted to reach.
COVERAGE_RADIUS_KM=60
# The largest number of nodes one run predicts from. The strongest
# sites are taken first.
COVERAGE_MAX_NODES=600
# The roles a run predicts from. The default is the infrastructure set,
# which is what a published map wants. ALL predicts from every node and
# is a diagnostic: the dashboard and the public embed both label such a
# run rather than passing it off as coverage.
COVERAGE_SITE_ROLES=ROUTER,ROUTER_LATE,REPEATER
# Also predict a second, wider map from the ordinary nodes that repeat
# traffic: CLIENT, CLIENT_BASE and ROUTER_CLIENT. CLIENT_MUTE is never
# included, because the firmware says it does not forward for others.
#
# Off by default, and the cost is the reason: a run predicts from every
# site it is given, and a mesh has far more clients than routers.
#
# When it is on, the dashboard offers a picker and the infrastructure
# map stays the default view. The public embed serves the
# infrastructure map only, whatever this is set to.
COVERAGE_INCLUDE_CLIENTS=false
# Worker processes. Zero means as many as the machine has, less one.
# On a small box that also serves the dashboard, set this to 1.
COVERAGE_WORKERS=0
# How much to lower the priority of each worker. The engine pins a core
# for minutes, and a niced run leaves the machine responsive while still
# taking every idle cycle. Zero turns it off.
COVERAGE_WORKER_NICE=10
# The receiver the map assumes: a handheld with a stock antenna.
# How coarse a position may be and still anchor a prediction, in bits.
# Zero turns the test off. 16 is the finest the public Meshtastic broker
# relays. Most of a mesh that arrives through it needs a position in
# the overrides file (RADIO_OVERRIDES_PATH) instead. This may raise the
# floor. It may not lower it: 1 to 15 is read as 16, because every
# published map predicts from precise positions only (#315). See
# docs/COVERAGE.md 9.1.2.1.
COVERAGE_MIN_PRECISION_BITS=16
# Also publish an approximate map of each site set, which also takes
# positions rounded down to COVERAGE_APPROXIMATE_MIN_BITS (13 is 2.9 km).
# It is a separate, dashboard-only map. The public embed never serves
# it. Off by default: it costs one more prediction of each map.
COVERAGE_INCLUDE_APPROXIMATE=false
COVERAGE_APPROXIMATE_MIN_BITS=13
COVERAGE_RX_HEIGHT_M=1.5
COVERAGE_RX_GAIN_DBI=2.15
# The zoom levels of tile the job writes. Level 11 is finer than the
# 90 m terrain, so there is nothing to gain past it.
COVERAGE_MIN_ZOOM=6
COVERAGE_MAX_ZOOM=11

# Read models (#371). The jobs service builds the views that cover hours
# or days -- the graph, the longest-link board, the broadcast rates and the
# coverage page's node list -- and the API reads the stored answer. One
# older than three build intervals is not used: the API computes the view
# live instead. 30 day windows are built on every LONG_EVERY-th run.
READ_MODELS_ENABLED=true
READ_MODELS_INTERVAL_MINUTES=10
READ_MODELS_LONG_EVERY=3

# The jobs supervisor (#371). Each job run is its own process with its own
# memory ceiling in MB; a job over its ceiling is stopped alone. Runs
# overlap when they fit in the container's memory and wait otherwise. Each
# run's peak is logged and plans the next. JOBS_MEMORY_BUDGET_MB=0 reads
# the container's limit. JOBS_ISOLATE=false runs every job in one process.
JOBS_ISOLATE=true
JOBS_MEMORY_LIMITS=coverage=800,calibration=400,gaps=400,read-models=400,rf-rollup=250,snapshot=250
JOBS_MEMORY_BUDGET_MB=0
# The memory limit of the whole jobs container. docker-compose.yml reads it
# as `mem_limit`, for example 2g. 0 means no limit, which is Docker's
# default. Do not confuse it with JOBS_MEMORY_LIMITS above: those are the
# ceilings of each job inside the container. With a limit, the kernel stops
# a job that does not fit inside this container, not the API. See
# docs/OPERATIONS.md 5.5.
JOBS_MEMORY_LIMIT=0

# Coverage gaps. The job measures which nodes the mesh is not carrying
# well, from the packets already stored, and writes one file for each
# modem preset beside the coverage runs. It predicts nothing and runs no
# engine. See docs/GAPS.md.
GAPS_ENABLED=true
# How often the assessment is rebuilt. The signals are only SQL, so
# freshness is cheap.
GAPS_INTERVAL_MINUTES=30
# The measurement window. Never set this above RETENTION_DAYS_PACKET,
# or the window reads ground that has already been deleted.
GAPS_WINDOW_HOURS=168
#
# EVERY THRESHOLD BELOW IS A STARTING POINT, NOT A MEASUREMENT.
# docs/ISSUES.md 2.10 names the six figures to take off live data first.
# A signal that flags three hundred nodes is a definition problem, not a
# finding.
#
# Below this many distinct packets a node is `unknown`, never `bad`. A
# node that says almost nothing is usually switched off.
GAPS_MIN_PACKETS=20
# Below this many active hours the intermittency signal is `unknown`.
GAPS_MIN_ACTIVE_HOURS=12
# The intermittency line: the share of its awake hours in which anything
# on the air heard the node.
GAPS_RF_RATIO_BAD=0.5
# The weak margin line, in dB above what the preset needs to demodulate.
# Long fast needs about -25 dB, so a reported SNR of -20 dB is a working
# link with about 5 dB to spare.
GAPS_MARGIN_BAD_DB=5.0
# How many neighbour reports a node must publish before its own receiver
# counts as proven.
GAPS_MIN_NEIGHBOUR_REPORTS=2
# How far apart two reported positions must be before a node counts as
# mobile, in kilometres. A mobile node is still listed.
GAPS_MOBILE_SPREAD_KM=1.0
#
# The siting half. It answers "where would one new node help the most
# people", and it is the only part of the gaps feature that runs the
# coverage engine. It runs inside the coverage cycle, never beside it.
# See docs/GAPS.md.
GAPS_SITING_ENABLED=true
# How far apart two struggling nodes must be before they count as two
# places that need help, in metres.
GAPS_DEMAND_CELL_M=300
# Single linkage distance for grouping demand into areas, in kilometres.
GAPS_CLUSTER_LINK_KM=8.0
# Below this many demand points it is a node, not an area.
GAPS_MIN_CLUSTER=3
# The most areas one run reports. It bounds the engine work.
GAPS_MAX_CLUSTERS=8
# How far around an area to look for ground, in kilometres.
GAPS_SEARCH_RADIUS_KM=15.0
# How far a candidate must stand above the ground around it, in metres.
GAPS_MIN_PROMINENCE_M=40.0
# The closest two candidates may stand, in kilometres.
GAPS_CANDIDATE_SPACING_KM=1.5
# How many candidates of one area enter the terrain screen, and how many
# of them reach the engine.
GAPS_CANDIDATES_PER_CLUSTER=60
GAPS_SPLAT_PER_CLUSTER=3
# The hard ceiling on engine runs in one cycle.
GAPS_MAX_PREDICTIONS=24
# The candidate node the page assumes: its prediction radius in
# kilometres, its transmit power in dBm, and its antenna height in
# metres. These are assumptions, and the page prints them.
GAPS_CANDIDATE_RADIUS_KM=25.0
GAPS_CANDIDATE_TX_POWER_DBM=30.0
GAPS_CANDIDATE_HEIGHT_M=9.0
# Engine workers for the candidate step, and how much to lower their
# priority. One niced worker suits a small box that also serves the page.
GAPS_WORKERS=1
GAPS_WORKER_NICE=10

# The public coverage embed. It is off until you turn it on, which is
# the same default STORE_TEXT_MESSAGES takes: the private value is the
# safe one.
#
# The embed is its own page at /embed/coverage. It shows the coverage
# and the infrastructure sites, with the positions snapped to a grid.
# It never shows a client node.
EMBED_ENABLED=false
# The sites that may put the embed in a frame, comma separated. Give
# full origins. Anything else is dropped, and an empty list means
# nothing may frame it.
EMBED_FRAME_ANCESTORS=
# How far to snap a public marker, in degrees. About 0.01 is a
# kilometre, which names a hill and not a building.
EMBED_POSITION_STEP=0.01

# Calibration. The job asks the mesh how far the prediction is out,
# node by node, from the neighbour reports the nodes publish.
CALIBRATION_ENABLED=true
CALIBRATION_INTERVAL_HOURS=24
# How far back to read neighbour reports. They are kept for
# RETENTION_DAYS_METRIC days, so a longer window reads nothing.
CALIBRATION_WINDOW_HOURS=336

# Radio overrides. The file names the antenna, the mast height, and the
# power of a node, which the mesh itself never reports. It can also give
# the real position of a coverage site. It is kept in the repository, so
# every change to it has an author and a review. A file that is not
# there gives no overrides. To keep an owner's position out of the
# repository, point this at a file on the host: docs/DEPLOY.md 8.
RADIO_OVERRIDES_PATH=config/nodes.yaml

# Logging.
LOG_LEVEL=INFO

# Scheduled database backups. The `backup` service writes a dump of the
# database once per interval, and keeps the newest BACKUP_KEEP_DAILY
# backups plus the newest backup of each of the last BACKUP_KEEP_WEEKLY
# weeks. See docs/DATABASE.md section 9.
#
# The host directory for the files. A relative path is relative to the
# project root. Put it on a disk with room for about ten dumps.
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_INTERVAL_SECONDS=86400
# The healthcheck fails after this many failed attempts in a row. 0
# turns this off; then only the age of the last good backup counts.
BACKUP_FAIL_LIMIT=3
# The uid and gid that write the files. The default, 1000, is the
# postgres user of the database image; the host directory must be
# writable by it. Under rootless Docker set both to 0: root in the
# container is the account that runs Docker.
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_MEMORY_LIMIT=512m
